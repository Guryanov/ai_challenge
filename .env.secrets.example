# Чувствительные данные. Скопируйте файл в .env.secrets и заполните значениями.
# .env.secrets указан в .gitignore и не должен попадать в репозиторий.
# Ниже — примеры переменных, которые можно использовать.

# --- Обязательные ---
# URL внешнего API (OpenAI-совместимый endpoint или свой).
EXTERNAL_API_URL=https://api.example.com/v1/chat/completions
# Ключ авторизации (если API его требует).
# API_KEY=sk-your-key-here

# --- Авторизация (AUTH_TYPE) ---
# bearer    -> заголовок Authorization: Bearer <key>
# x-api-key -> заголовок X-API-Key: <key>
# api-key   -> заголовок Api-Key: <key>
# none      -> без авторизации
# AUTH_TYPE=bearer

# --- Формат API (API_FORMAT) ---
# openai  -> POST /v1/chat/completions (messages)
# generic -> POST {"message": "..."}
# API_FORMAT=openai

# --- Промпты (переопределяют значения из .env) ---
# SYSTEM_PROMPT=Ты полезный ассистент. Отвечай кратко и по существу.
# ASSISTANT_PROMPT=Конечно, вот ответ:
# USER_PROMPT_TEMPLATE=Вопрос: {message}
# Ответ:

# --- Прочее ---
# PORT=8080

# --- Готовые примеры конфигураций ---
#
# 1) Публичное API без авторизации (для теста):
#    EXTERNAL_API_URL=https://httpbin.org/anything
#    AUTH_TYPE=none
#    API_FORMAT=generic
#
# 2) OpenAI-совместимый сервис с Bearer-токеном:
#    EXTERNAL_API_URL=https://api.openai.com/v1/chat/completions
#    API_KEY=sk-...
#    AUTH_TYPE=bearer
#    API_FORMAT=openai
#
# 3) Внутренний API с заголовком X-API-Key и generic-форматом:
#    EXTERNAL_API_URL=https://internal.local/api/chat
#    API_KEY=secret-token
#    AUTH_TYPE=x-api-key
#    API_FORMAT=generic
