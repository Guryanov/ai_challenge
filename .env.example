# Нечувствительные настройки приложения.

# Тип авторизации: bearer (по умолчанию), x-api-key, api-key, none.
AUTH_TYPE=bearer

# Формат API: openai (для /v1/chat/completions) или generic (произвольный POST с полем message).
API_FORMAT=generic

# Промпты.
# SYSTEM_PROMPT задаёт поведение ассистента.
# ASSISTANT_PROMPT добавляет сообщение от ассистента перед ответом (prefix).
# USER_PROMPT_TEMPLATE позволяет обернуть сообщение пользователя. Используйте {message} для подстановки.
# SYSTEM_PROMPT=Ты полезный ассистент. Отвечай кратко и по существу.
# ASSISTANT_PROMPT=Конечно, вот ответ:
# USER_PROMPT_TEMPLATE=Вопрос: {message}\nОтвет:

# Порт HTTP-сервера (по умолчанию 8080).
PORT=8080
