# Нечувствительные настройки.
AUTH_TYPE=bearer
API_FORMAT=openai
MODEL=SMLab-ext/DeepSeek-V4.1-Flash
# Алиас модели в LiteLLM-шлюзе (см. litellm.yaml). Реальная модель задаётся там.

# SYSTEM_PROMPT=Ты являешься группой экспертов: программистом, тестировщиком и пользователем. Нужно чтобы каждый эксперт предоставил свое решение   
# ASSISTANT_PROMPT=Конечно, вот ответ:
# USER_PROMPT_TEMPLATE=Вопрос: {message}\nОтвет:
PORT=8080
# Таймаут HTTP-запросов к внешнему API (например, 60s, 2m, 5m).
TIMEOUT=6m
# Максимальное количество токенов для генерации summary при стратегии summary.
# SUMMARY_MAX_TOKENS=500

# База знаний: chunking, эмбеддинги, SQLite.
# Путь к SQLite-базе индекса (каталог создаётся автоматически).
INDEX_DB_PATH=data/index.db
# Провайдер эмбеддингов: openai (OpenAI-совместимый /v1/embeddings) или ollama.
# При работе через LiteLLM-шлюз используем openai-формат (/v1/embeddings).
EMBED_API_FORMAT=openai
# Модель эмбеддингов — алиас в LiteLLM-шлюзе (см. litellm.yaml).
EMBED_MODEL=SMLab/bge-m3
# URL эмбеддингов LiteLLM-шлюза (см. litellm.yaml).
EMBED_API_URL=https://api.ai.localcorp.net/v1/embeddings
# Ключ эмбеддингов; при пустом значении используется API_KEY (виртуальный ключ LiteLLM).
# EMBED_API_KEY=
EMBED_BATCH=32
# Альтернатива в обход LiteLLM — напрямую в локальный Ollama:
# EMBED_API_FORMAT=ollama
# OLLAMA_URL=http://localhost:11434
# OLLAMA_EMBED_MODEL=nomic-embed-text
# Параметры chunking (в символах).
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
CHUNK_MIN_SIZE=200
# Количество результатов поиска по умолчанию и лимит размера загружаемого файла (МБ).
SEARCH_TOP_K=5
MAX_UPLOAD_MB=10
# RAG: подавать релевантные фрагменты базы знаний в ответ агента (переключается в UI).
RAG_ENABLED=true
# Стратегия поиска по умолчанию: structure или fixed.
RAG_STRATEGY=structure
# Сколько фрагментов (top-K) подмешивать в контекст ответа.
RAG_TOP_K=5
# Второй этап retrieval: число кандидатов из векторного поиска до фильтра (>= SEARCH_TOP_K).
SEARCH_CANDIDATES=20
# Режим фильтрации: threshold (порог cosine) или none (без фильтра).
RERANK_MODE=threshold
# Порог отсечения cosine; отрицательное значение отключает фильтр.
RERANK_THRESHOLD=0.35

# Конвейер Sentry → Jira → фикс → PR (см. README).
# Включить фоновый конвейер (раз в сутки) и время запуска HH:MM (локальное).
PIPELINE_ENABLED=false
PIPELINE_AT=09:00
# Запрос к Sentry для отбора критических issue.
SENTRY_ISSUE_QUERY=is:unresolved level:fatal
# SENTRY_ORGANIZATION=
# SENTRY_PROJECT=
# Целевой GitHub-репозиторий и Jira-проект (обязательны при PIPELINE_ENABLED=true).
# REPO_OWNER=
# REPO_NAME=
REPO_BASE_BRANCH=main
# Локальный чекаут для автоиндексации кода и project_id базы знаний.
REPO_ROOT=.
REPO_PROJECT_ID=repo
REPO_INDEX_ON_START=true
REPO_INDEX_EXTENSIONS=.go,.md,.yaml,.yml,.json,.txt,.html,.css,.js,.sh,.sql
REPO_INDEX_MAX_FILE_KB=256
# JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Task
# Ограничители: не более N issue за запуск и N файлов на фикс.
PIPELINE_MAX_ISSUES_PER_RUN=1
PIPELINE_MAX_FILES_PER_FIX=3
