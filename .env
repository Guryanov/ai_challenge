# Нечувствительные настройки.
AUTH_TYPE=bearer
API_FORMAT=openai
MODEL=SMLab-ext/DeepSeek-V4.1-Flash
# SYSTEM_PROMPT=Ты являешься группой экспертов: программистом, тестировщиком и пользователем. Нужно чтобы каждый эксперт предоставил свое решение   
# ASSISTANT_PROMPT=Конечно, вот ответ:
# USER_PROMPT_TEMPLATE=Вопрос: {message}\nОтвет:
PORT=8080
# Таймаут HTTP-запросов к внешнему API (например, 60s, 2m, 5m).
TIMEOUT=6m
# Максимальное количество токенов для генерации summary при стратегии summary.
# SUMMARY_MAX_TOKENS=500

# Ежедневная сводка популярных фильмов через MCP-сервер trakt.
DAILY_DIGEST_ENABLED=true
DAILY_DIGEST_AT=22:52
DAILY_DIGEST_PROMPT="Ты блогер, который составляет чарт фильмов, собери популярные фильмы за последние сутки и сделай сводку"

# База знаний: chunking, эмбеддинги, SQLite.
# Путь к SQLite-базе индекса (каталог создаётся автоматически).
INDEX_DB_PATH=data/index.db
# Провайдер эмбеддингов: openai (OpenAI-совместимый /v1/embeddings) или ollama.
EMBED_API_FORMAT=openai
# Модель эмбеддингов. Для openai по умолчанию SMLab/bge-m3, для ollama — nomic-embed-text.
EMBED_MODEL=SMLab/bge-m3
# URL эмбеддингов. Для openai при пустом значении выводится из EXTERNAL_API_URL:
# .../chat/completions -> .../embeddings. Для ollama используется OLLAMA_URL.
# EMBED_API_URL=
# Ключ эмбеддингов; при пустом значении используется API_KEY.
# EMBED_API_KEY=
EMBED_BATCH=32
# Альтернатива без корпоративного API — локальный Ollama:
# EMBED_API_FORMAT=ollama
# OLLAMA_URL=http://localhost:11434
# OLLAMA_EMBED_MODEL=nomic-embed-text
# Параметры chunking (в символах).
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
CHUNK_MIN_SIZE=200
# Количество результатов поиска по умолчанию и лимит размера загружаемого файла (МБ).
SEARCH_TOP_K=5
MAX_UPLOAD_MB=10
# RAG: подавать релевантные фрагменты базы знаний в ответ агента (переключается в UI).
RAG_ENABLED=true
# Стратегия поиска по умолчанию: structure или fixed.
RAG_STRATEGY=structure
# Сколько фрагментов (top-K) подмешивать в контекст ответа.
RAG_TOP_K=5
# Второй этап retrieval: число кандидатов из векторного поиска до фильтра (>= SEARCH_TOP_K).
SEARCH_CANDIDATES=20
# Режим фильтрации: threshold (порог cosine) или none (без фильтра).
RERANK_MODE=threshold
# Порог отсечения cosine; отрицательное значение отключает фильтр.
RERANK_THRESHOLD=0.35
